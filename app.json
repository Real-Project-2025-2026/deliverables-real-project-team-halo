{
  "expo": {
    "name": "Halo",
    "slug": "halo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haloapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Halo needs your location to track your trip and keep you safe.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Halo needs your location in the background to monitor your safety during trips.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "location",
          "remote-notification"
        ],
        "NSUserNotificationsUsageDescription": "Halo needs to send you safety check-in notifications.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.kelbidani.haloapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5170FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5170ff",
          "dark": {
            "backgroundColor": "#5170ff"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Halo needs your location to track your trip and keep you safe.",
          "locationAlwaysPermission": "Halo needs your location in the background to monitor your safety during trips.",
          "locationWhenInUsePermission": "Halo needs your location to track your trip and keep you safe.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Halo needs access to your photo library to set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5170FF",
          "sounds": []
        }
      ],
      [
        "react-native-maps",
        {
          "ios": {
            "mapType": "standard"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "826115b6-20f2-44a2-a368-1c295af5ec8b"
      }
    }
  }
}
